# Neon Postgres (serverless HTTP driver) — get from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Stripe — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook signing secret — get after creating the webhook endpoint
# (https://dashboard.stripe.com/test/webhooks), or from `stripe listen` locally
STRIPE_WEBHOOK_SECRET="whsec_..."

# Simple password gate for /admin (no full auth system)
ADMIN_PASSWORD="change-me"

# Base URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
