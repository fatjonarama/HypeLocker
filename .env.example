# Neon Postgres (serverless HTTP driver) — get from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Signs customer account session cookies — any long random string.
# Admin access is granted per-account via users.is_admin, checked from
# this same signed session (see README for how to promote an account).
SESSION_SECRET="change-me-to-a-long-random-string"

# Vercel Blob storage token for admin product photo uploads.
# Auto-filled by Vercel once you connect Blob storage to the project
# (Project → Storage → Create Database → Blob). For local dev, copy the
# token from Vercel's dashboard after connecting it.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Base URL used for links in the app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
